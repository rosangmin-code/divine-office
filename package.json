{
  "name": "divine-office",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:api": "playwright test api.spec.ts",
    "test:e2e:core": "playwright test e2e/api.spec.ts e2e/prayer-sections.spec.ts e2e/page-references.spec.ts e2e/pwa.spec.ts e2e/calendar-list-month.spec.ts e2e/prayer-footer.spec.ts",
    "traceability": "node scripts/generate-test-fr-map.mjs",
    "traceability:check": "node scripts/generate-test-fr-map.mjs --check",
    "verify:body-purity": "node scripts/verify-body-purity.js",
    "verify:body-purity:check": "node scripts/verify-body-purity.js --check",
    "verify:first-vespers-ref": "node scripts/verify-first-vespers-ref-coverage.js",
    "verify:phrase-coverage": "node scripts/verify-phrase-coverage.js",
    "verify:phrase-coverage:check": "node scripts/verify-phrase-coverage.js --check",
    "verify:hymn-phrase-merge": "node scripts/verify-hymn-phrase-merge.js",
    "verify:psalter-parity": "node scripts/verify-psalter-plain-rich-parity.js",
    "verify:psalter-parity:check": "node scripts/verify-psalter-plain-rich-parity.js --check",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:pages": "node scripts/verify-psalter-pages.js && node scripts/verify-psalter-body-pages.js && node scripts/verify-hymn-pages.js && node scripts/verify-compline-pages.js && node scripts/verify-propers-pages.js && node scripts/verify-sanctoral-pages.js"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "^16.3.5",
    "pdfjs-dist": "^5.6.205",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "romcal": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
