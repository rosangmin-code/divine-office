  "intercessionsRich": {
    "blocks": [
      {
        "kind": "para",
        "spans": [
          {
            "kind": "text",
            "text": "Өөрийнхөө сонгосон ард түмнийг Өөрийн мөнхийн Үгээр дамжуулан ялзралаас ангижирсан үр удамд дахин төрүүлсэн Эцэгт бүх талархлаа илэрхийлцгээе. Үүнийг Түүний хүүхдүүдийнх нь хувьд гуйн залбирцгаая:"
          }
        ]
      },
      {
        "kind": "para",
        "indent": 1,
        "spans": [
          {
            "kind": "text",
            "text": "Эзэн минь, Та Өөрийн хүмүүстээ нигүүлсэнгүй хандана уу."
          }
        ]
      },
      {
        "kind": "divider"
      },
      {
        "kind": "stanza",
        "lines": [
          {
            "indent": 0,
            "spans": [
              {
                "kind": "text",
                "text": "Нигүүлсэнгүй Тэнгэрбурхан минь, Таны бүх хүмүүст зориулсан бидний залбирлуудыг Та сонсоно уу."
              }
            ]
          },
          {
            "indent": 1,
            "spans": [
              {
                "kind": "rubric",
                "text": "- "
              },
              {
                "kind": "text",
                "text": "Тэд бие махбодийн хоол хүнсээс илүүтэйгээр Таны үгээр өлсөх болтугай."
              }
            ]
          }
        ]
      },
      {
        "kind": "divider"
      },
      {
        "kind": "para",
        "spans": [
          {
            "kind": "text",
            "text": "Бүх хүн төрөлхтөн болон үндэстнийхээ төлөө үнэн бөгөөд бодит хайрыг Та бидэнд хайрлан соёрхоно уу."
          }
        ]
      },
      {
        "kind": "divider"
      },
      {
        "kind": "stanza",
        "lines": [
          {
            "indent": 0,
            "spans": [
              {
                "kind": "text",
                "text": "Усан угаалаар дахин төрөх гэж буй хүмүүсийг Та хайраар харна уу."
              }
            ]
          },
          {
            "indent": 1,
            "spans": [
              {
                "kind": "rubric",
                "text": "- "
              },
              {
                "kind": "text",
                "text": "Ингэснээр тэд Таны Ариун Сүнсний сүм хийдийн амьд чулуу нь болох болно."
              }
            ]
          }
        ]
      },
      {
        "kind": "divider"
      },
      {
        "kind": "stanza",
        "lines": [
          {
            "indent": 0,
            "spans": [
              {
                "kind": "text",
                "text": "Та Ионагийн номлолоор Ниневе хотыг наманчлахад хүргэсэн тул"
              }
            ]
          },
          {
            "indent": 1,
            "spans": [
              {
                "kind": "rubric",
                "text": "- "
              },
              {
                "kind": "text",
                "text": "Өөрийн үгийн номлолоор Та гэм нүгэлтнүүдийн зүрх сэтгэлд нигүүлсэнгүй нэвтрэн орж ирнэ үү."
              }
            ]
          }
        ]
      },
      {
        "kind": "divider"
      },
      {
        "kind": "stanza",
        "lines": [
          {
            "indent": 0,
            "spans": [
              {
                "kind": "text",
                "text": "Амь тэмцэж буй хүмүүс өөрийн шүүгч Христтэй уулзахаар найдвартай явах болтугай."
              }
            ]
          },
          {
            "indent": 1,
            "spans": [
              {
                "kind": "rubric",
                "text": "- "
              },
              {
                "kind": "text",
                "text": "Тэд Таны сүр жавхланг хараад, мөнхөд баярлан цэнгэх болтугай."
              }
            ]
          }
        ]
      }
    ],
