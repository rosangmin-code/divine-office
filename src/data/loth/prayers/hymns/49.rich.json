            "spans": [
              {
                "kind": "text",
                "text": "Илүү хайр, илүү хүч чадлыг надад дүүргэн өгөөч ээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Эзэн минь, Та миний амьдралд эгнэгт дүүрэн"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "байгаач ээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Би Таныг хүндэлье, бүхий л зүрхээрээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Би Таныг хүндэлье, бүхий л хүслээрээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Би Таныг хүндэлье, бүхий л хүчээрээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Өө, миний Эзэн, миний Эзэн"
