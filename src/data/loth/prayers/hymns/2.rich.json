            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Аврал тусламж гуйн ирлээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Өөрөөсөө намайг холдуулбал"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Өчүүхэн би хаачих вэ"
              }
            ],
            "indent": 0
          }
        ],
