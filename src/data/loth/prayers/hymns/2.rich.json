            "spans": [
              {
                "kind": "text",
                "text": "Дахилт: Та миний гэмийг цагаатган"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Тамлуулан алагдсан"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Чин сэтгэлээсээ гэмшихээр"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Эзэн Тандаа ирж байна"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Эхлэл ба төгсгөл Их Эзэн"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Мөнхөд үхэх сүнснүүдийг"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Эрдэнэт цусаараа аварсан"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Есүсийн хайр хязгааргүй"
              }
            ],
            "indent": 0
          }
        ],
