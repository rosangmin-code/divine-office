              {
                "kind": "text",
                "text": "Есүс хамгийн нандин нэр юм аа"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Есүс Та үргэлж гуйлтад хариулдаг"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "ӨӨ Есүс миний гараас барьдаг Эзэн"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Хамгийн нандин Түүний нэр Есүс"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Есүсээ магтан дуулахыг хүсэж байна"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Есүс бол эхлэл ба эцэс юмаа"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "ӨӨ миний төлөө зовлон амссан Есүс"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Хамгийн нандин Түүний нэр Есүс"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Есүс Хаадын Хаан болсон Эзэн"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Есүс Таны хайр хязгааргүй юм аа"
              }
