            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "чадахгүй"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Итгэлт Христийн хайр үүрд мөнхөд биднийг"
