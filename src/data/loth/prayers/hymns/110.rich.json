        "lines": [
          {
            "spans": [
              {
                "kind": "text",
                "text": "Цээжинд цохилох зүрх. Сэтгэлд орших Сүнсээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Хайранд уярах зүрх. Хагацалд урсах нулимс"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Хүн хүнээ хайрлах сэтгэл. Хүсэл бодлын Эзэн"
              }
            ],
            "indent": 0
          }
        ],
        "phrases": [
          {
            "lineRange": [
              0,
              0
