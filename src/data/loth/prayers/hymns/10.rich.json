        "lines": [
          {
            "spans": [
              {
                "kind": "text",
                "text": "Амар амгалан Мариа минь ээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Та хишиг ивээлээр бялхам билээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Эзэн тантай хамт байна"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Таныг эмэгтэйчүүдийн дундаас адисалсан билээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Таны хэвлий дэх үр Есүсийг бас адисалсан билээ"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Тэнгэрбурханы эх гэгээн Мариа минь"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Одоо болон насан эцэслэх мөчид"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Нүгэлт бидний төлөө залбиран соёрхооч Амэн,"
              }
            ],
            "indent": 0
          },
          {
            "spans": [
              {
                "kind": "text",
                "text": "Амэн"
              }
            ],
            "indent": 0
          }
